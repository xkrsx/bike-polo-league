generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TeamAssigned {
  TEAM_A
  TEAM_B
}

enum PlayoffRound {
  SEMIFINAL_1
  SEMIFINAL_2
  THIRD_PLACE
  GRAND_FINAL
}

model Player {
  id                String       @id @default(cuid())
  name              String
  isRookie          Boolean      @default(false)
  extraPoints       Int          @default(0) // Costume (+5) plus custom bonus
  podiumPoints      Int          @default(0) // 0, 15, 10, or 5
  costumeBonus      Boolean      @default(false)
  customBonusLabel  String       @default("")
  customBonusValue  Int          @default(0)
  createdAt         DateTime     @default(now())
  refereedGames     Game[]         @relation("GameReferee")
  assistedGames     Game[]         @relation("GameAssistant")
  gameStats         GamePlayer[]
  finalsRoster      FinalsRoster[]
  playoffLines      PlayoffLine[]
}

model Game {
  id               String       @id @default(cuid())
  date             DateTime     @default(now()) // Data rozegrania meczu (kolejka)
  scoreTeamA       Int
  scoreTeamB       Int
  status           String       @default("PENDING") // PENDING | APPROVED | REJECTED
  refSheetImageUrl String?
  submittedBy      String       @default("")
  refereeId        String?
  referee          Player?      @relation("GameReferee", fields: [refereeId], references: [id], onDelete: Restrict)
  assistantId      String?
  assistant        Player?      @relation("GameAssistant", fields: [assistantId], references: [id], onDelete: Restrict)
  createdAt        DateTime     @default(now())
  players          GamePlayer[]
}

model GamePlayer {
  gameId       String
  playerId     String
  teamAssigned TeamAssigned
  goals        Int           @default(0)
  ownGoals     Int          @default(0)
  fouls        Int?          @default(0)
  game         Game          @relation(fields: [gameId], references: [id])
  player       Player        @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@id([gameId, playerId])
}

model Finals {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now())
  locked    Boolean        @default(true) // Snake-draft rosters stay fixed for every playoff game
  teams     FinalsTeam[]
  matches   PlayoffMatch[]
}

model FinalsTeam {
  id       String         @id @default(cuid())
  finalsId String
  number   Int
  finals   Finals         @relation(fields: [finalsId], references: [id], onDelete: Cascade)
  members  FinalsRoster[]

  @@unique([finalsId, number])
}

model FinalsRoster {
  teamId   String
  playerId String     @unique
  seedRank Int
  team     FinalsTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player   Player     @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@id([teamId, playerId])
}

model PlayoffMatch {
  id         String       @id @default(cuid())
  finalsId   String
  round      PlayoffRound
  homeNumber Int?
  awayNumber Int?
  finals     Finals       @relation(fields: [finalsId], references: [id], onDelete: Cascade)
  lines      PlayoffLine[]

  @@unique([finalsId, round])
}

model PlayoffLine {
  matchId  String
  playerId String
  goals    Int          @default(0)
  match    PlayoffMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player   Player       @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@id([matchId, playerId])
  @@index([playerId])
}