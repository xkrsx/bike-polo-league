generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TeamAssigned {
  TEAM_A
  TEAM_B
}

model Player {
  id                String       @id @default(cuid())
  name              String
  isRookie          Boolean      @default(false)
  extraPoints       Int          @default(0) // Costume (+5) plus custom bonus
  podiumPoints      Int          @default(0) // 0, 15, 10, or 5
  costumeBonus      Boolean      @default(false)
  customBonusLabel  String       @default("")
  customBonusValue  Int          @default(0)
  createdAt         DateTime     @default(now())
  refereedGames     Game[]       @relation("GameReferee")
  gameStats         GamePlayer[]
}

model Game {
  id           String       @id @default(cuid())
  date         DateTime     @default(now()) // Data rozegrania meczu (kolejka)
  scoreTeamA   Int
  scoreTeamB   Int
  refereeId    String?
  referee      Player?      @relation("GameReferee", fields: [refereeId], references: [id], onDelete: Restrict)
  createdAt    DateTime     @default(now())
  players      GamePlayer[]
}

model GamePlayer {
  gameId       String
  playerId     String
  teamAssigned TeamAssigned
  goals        Int           @default(0)
  ownGoals     Int          @default(0)
  fouls        Int?          @default(0)
  game         Game          @relation(fields: [gameId], references: [id])
  player       Player        @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@id([gameId, playerId])
}